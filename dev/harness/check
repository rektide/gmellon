#!/bin/sh
# Maintained explicit entry points for external-tool harness coverage.
set -eu

usage() {
	cat <<'EOF'
usage: dev/harness/check [--keep-success] MODE

MODE:
  rust-cargo    run ignored Rust real-daemon login-control tests with cargo test
  rust-nextest run ignored Rust real-daemon login-control tests with cargo nextest
  rust-broker   run the ignored Rust private-broker collection proof with cargo nextest
  rust-cli      run the ignored Rust private-broker CLI binary proof with cargo nextest
  python        run Python lifecycle tests, behavior matrix, and smoke proof
  broker        run private dbus-broker lifecycle tests and interface proof
  all           run rust-nextest, rust-broker, rust-cli, control-only Python, and broker checks

An explicit invocation fails before testing when a required external tool is
missing. Ordinary `cargo test` and `cargo nextest run` visibly skip the
ignored Rust real-daemon tests instead (the control proof needs
--features login-control even to compile; it is an empty target without it).
EOF
}

fail() {
	printf 'HARNESS PREREQUISITE FAILURE: %s\n' "$*" >&2
	exit 125
}

need_path_tool() {
	command -v "$1" >/dev/null 2>&1 || fail "$1 was not found on PATH; $2"
}

need_daemon() {
	if [ -x /usr/bin/gnome-keyring-daemon ]; then
		DAEMON=/usr/bin/gnome-keyring-daemon
	elif [ -x /bin/gnome-keyring-daemon ]; then
		DAEMON=/bin/gnome-keyring-daemon
	else
		fail 'gnome-keyring-daemon was not found in /usr/bin or /bin; install the system GNOME Keyring daemon package'
	fi
	"$DAEMON" --version >/dev/null 2>&1 || fail "$DAEMON is present but not runnable"
}

need_common() {
	need_path_tool python3 'install Python 3 and make `python3` available'
	need_daemon
	[ -x dev/harness/lifecycle.py ] || fail 'dev/harness/lifecycle.py is missing or not executable'
}

need_fixed_tool() {
	if [ -x "/usr/bin/$1" ]; then
		return
	fi
	if [ -x "/bin/$1" ]; then
		return
	fi
	fail "$1 was not found in /usr/bin or /bin; $2"
}

need_broker() {
	need_common
	need_fixed_tool systemd-socket-activate 'install the systemd test utilities'
	need_fixed_tool dbus-broker-launch 'install dbus-broker'
	need_fixed_tool gdbus 'install the GLib D-Bus command-line tools'
	[ -S /run/systemd/journal/socket ] || \
		fail 'host journal socket /run/systemd/journal/socket is unavailable; dbus-broker-launch cannot start in this topology'
	[ -S /run/dbus/system_bus_socket ] || \
		fail 'host system bus /run/dbus/system_bus_socket is unavailable; the dbus-broker-launch --scope=system controller requires it'
	[ -d /run/systemd/system ] || \
		fail 'host systemd runtime /run/systemd/system is unavailable; --scope=system cannot be exercised'
	[ -x dev/harness/broker.py ] || fail 'dev/harness/broker.py is missing or not executable'
	[ -x dev/harness/private_bus_probe.py ] || fail 'dev/harness/private_bus_probe.py is missing or not executable'
}

need_rust_broker_proof() {
	need_broker
	need_fixed_tool busctl 'install systemd (busctl) for the lock-call monitor proof'
	need_fixed_tool stdbuf 'install coreutils (stdbuf) for line-buffered monitor output'
	need_path_tool cargo 'install the Rust toolchain and make `cargo` available'
	cargo nextest --version >/dev/null 2>&1 || \
		fail 'cargo-nextest is unavailable; install it to run the private-broker Rust proofs'
}

run_rust_broker() {
	need_rust_broker_proof
	if [ -n "$KEEP_SUCCESS" ]; then
		GMELL_HARNESS_KEEP_SUCCESS=1 \
			cargo nextest run --test broker_collections --run-ignored ignored-only
	else
		cargo nextest run --test broker_collections --run-ignored ignored-only
	fi
}

run_rust_cli() {
	need_rust_broker_proof
	if [ -n "$KEEP_SUCCESS" ]; then
		GMELL_HARNESS_KEEP_SUCCESS=1 \
			cargo nextest run --test broker_cli --run-ignored ignored-only
	else
		cargo nextest run --test broker_cli --run-ignored ignored-only
	fi
}

run_rust_cargo() {
	need_common
	need_path_tool cargo 'install the Rust toolchain and make `cargo` available'
	if [ -n "$KEEP_SUCCESS" ]; then
		GMELL_HARNESS_KEEP_SUCCESS=1 \
			cargo test --features login-control --test real_daemon -- --ignored
	else
		cargo test --features login-control --test real_daemon -- --ignored
	fi
}

run_rust_nextest() {
	need_common
	need_path_tool cargo 'install the Rust toolchain and make `cargo` available'
	cargo nextest --version >/dev/null 2>&1 || \
		fail 'cargo-nextest is unavailable; install it or use MODE rust-cargo'
	if [ -n "$KEEP_SUCCESS" ]; then
		GMELL_HARNESS_KEEP_SUCCESS=1 \
			cargo nextest run --features login-control --test real_daemon --run-ignored ignored-only
	else
		cargo nextest run --features login-control --test real_daemon --run-ignored ignored-only
	fi
}

run_python() {
	need_common
	python3 -m py_compile \
		dev/harness/smoke.py \
		dev/harness/behavior.py \
		dev/harness/lifecycle.py \
		dev/harness/tests/test_behavior.py \
		dev/harness/tests/test_lifecycle.py
	python3 -m unittest -v \
		dev/harness/tests/test_behavior.py \
		dev/harness/tests/test_lifecycle.py
	if [ -n "$KEEP_SUCCESS" ]; then
		dev/harness/behavior.py --keep-success
		dev/harness/smoke.py --keep-success
	else
		dev/harness/behavior.py
		dev/harness/smoke.py
	fi
}

run_broker() {
	need_broker
	python3 -m py_compile \
		dev/harness/broker.py \
		dev/harness/private_bus_probe.py \
		dev/harness/tests/test_broker.py
	python3 -m unittest -v dev/harness/tests/test_broker.py
	if [ -n "$KEEP_SUCCESS" ]; then
		dev/harness/broker.py --keep-success -- dev/harness/private_bus_probe.py
	else
		dev/harness/broker.py -- dev/harness/private_bus_probe.py
	fi
}

KEEP_SUCCESS=
if [ "${1-}" = "--keep-success" ]; then
	KEEP_SUCCESS=1
	shift
fi

[ "$#" -eq 1 ] || {
	usage >&2
	exit 2
}

case "$1" in
rust-cargo)
	run_rust_cargo
	;;
rust-nextest)
	run_rust_nextest
	;;
rust-broker)
	run_rust_broker
	;;
rust-cli)
	run_rust_cli
	;;
python)
	run_python
	;;
broker)
	run_broker
	;;
all)
	run_rust_nextest
	run_rust_broker
	run_rust_cli
	run_python
	run_broker
	;;
-h | --help)
	usage
	;;
*)
	usage >&2
	exit 2
	;;
esac
