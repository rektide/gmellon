#compdef gmellon

autoload -U is-at-least

_gmellon() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-v[Print redacted diagnostic events on stderr (operations, results, lengths). Password bytes and key material are never printed]' \
'--verbose[Print redacted diagnostic events on stderr (operations, results, lengths). Password bytes and key material are never printed]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_gmellon_commands" \
"*::: :->gmellon" \
&& ret=0
    case $state in
    (gmellon)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:gmellon-command-$line[1]:"
        case $line[1] in
            (list)
_arguments "${_arguments_options[@]}" : \
'-v[Print redacted diagnostic events on stderr (operations, results, lengths). Password bytes and key material are never printed]' \
'--verbose[Print redacted diagnostic events on stderr (operations, results, lengths). Password bytes and key material are never printed]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(status)
_arguments "${_arguments_options[@]}" : \
'-v[Print redacted diagnostic events on stderr (operations, results, lengths). Password bytes and key material are never printed]' \
'--verbose[Print redacted diagnostic events on stderr (operations, results, lengths). Password bytes and key material are never printed]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(unlock)
_arguments "${_arguments_options[@]}" : \
'--stdin[Read one password line from stdin instead of prompting on the TTY]' \
'-v[Print redacted diagnostic events on stderr (operations, results, lengths). Password bytes and key material are never printed]' \
'--verbose[Print redacted diagnostic events on stderr (operations, results, lengths). Password bytes and key material are never printed]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'::collection -- Stable collection ID; defaults to login:_default' \
&& ret=0
;;
(lock)
_arguments "${_arguments_options[@]}" : \
'-v[Print redacted diagnostic events on stderr (operations, results, lengths). Password bytes and key material are never printed]' \
'--verbose[Print redacted diagnostic events on stderr (operations, results, lengths). Password bytes and key material are never printed]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'::collection -- Stable collection ID; defaults to login:_default' \
&& ret=0
;;
(items)
_arguments "${_arguments_options[@]}" : \
'-v[Print redacted diagnostic events on stderr (operations, results, lengths). Password bytes and key material are never printed]' \
'--verbose[Print redacted diagnostic events on stderr (operations, results, lengths). Password bytes and key material are never printed]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'::collection -- Stable collection ID; defaults to login:_default' \
&& ret=0
;;
(ssh-list)
_arguments "${_arguments_options[@]}" : \
'-v[Print redacted diagnostic events on stderr (operations, results, lengths). Password bytes and key material are never printed]' \
'--verbose[Print redacted diagnostic events on stderr (operations, results, lengths). Password bytes and key material are never printed]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(ssh-add)
_arguments "${_arguments_options[@]}" : \
'--stdin[Read one passphrase line from stdin instead of prompting on the TTY]' \
'--askpass[Also allow the askpass helper to answer for this key]' \
'-v[Print redacted diagnostic events on stderr (operations, results, lengths). Password bytes and key material are never printed]' \
'--verbose[Print redacted diagnostic events on stderr (operations, results, lengths). Password bytes and key material are never printed]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':key -- Path to the SSH private key:_files' \
&& ret=0
;;
(ssh-allow)
_arguments "${_arguments_options[@]}" : \
'-v[Print redacted diagnostic events on stderr (operations, results, lengths). Password bytes and key material are never printed]' \
'--verbose[Print redacted diagnostic events on stderr (operations, results, lengths). Password bytes and key material are never printed]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':key -- Path to the SSH private key the passphrase was stored for:_files' \
&& ret=0
;;
(ssh-deny)
_arguments "${_arguments_options[@]}" : \
'-v[Print redacted diagnostic events on stderr (operations, results, lengths). Password bytes and key material are never printed]' \
'--verbose[Print redacted diagnostic events on stderr (operations, results, lengths). Password bytes and key material are never printed]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':key -- Path to the SSH private key the passphrase was stored for:_files' \
&& ret=0
;;
(ssh-remove)
_arguments "${_arguments_options[@]}" : \
'-v[Print redacted diagnostic events on stderr (operations, results, lengths). Password bytes and key material are never printed]' \
'--verbose[Print redacted diagnostic events on stderr (operations, results, lengths). Password bytes and key material are never printed]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':key -- Path to the SSH private key the passphrase was stored for:_files' \
&& ret=0
;;
(ssh-verify)
_arguments "${_arguments_options[@]}" : \
'-v[Print redacted diagnostic events on stderr (operations, results, lengths). Password bytes and key material are never printed]' \
'--verbose[Print redacted diagnostic events on stderr (operations, results, lengths). Password bytes and key material are never printed]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'::key -- Path to the SSH private key whose stored passphrase is verified:_files' \
&& ret=0
;;
(change)
_arguments "${_arguments_options[@]}" : \
'--stdin[Read current, new, and confirmation lines from stdin]' \
'-v[Print redacted diagnostic events on stderr (operations, results, lengths). Password bytes and key material are never printed]' \
'--verbose[Print redacted diagnostic events on stderr (operations, results, lengths). Password bytes and key material are never printed]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'::collection -- Stable collection ID; defaults to login:_default' \
&& ret=0
;;
(completions)
_arguments "${_arguments_options[@]}" : \
'-v[Print redacted diagnostic events on stderr (operations, results, lengths). Password bytes and key material are never printed]' \
'--verbose[Print redacted diagnostic events on stderr (operations, results, lengths). Password bytes and key material are never printed]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':shell -- Shell to generate completions for:(bash elvish fish powershell zsh)' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_gmellon__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:gmellon-help-command-$line[1]:"
        case $line[1] in
            (list)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(status)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(unlock)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(lock)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(items)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(ssh-list)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(ssh-add)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(ssh-allow)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(ssh-deny)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(ssh-remove)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(ssh-verify)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(change)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(completions)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_gmellon_commands] )) ||
_gmellon_commands() {
    local commands; commands=(
'list:List collection IDs, labels, and lock state' \
'status:Report service capabilities and collection lock state' \
'unlock:Unlock an existing collection' \
'lock:Lock an existing collection' \
'items:List items inside a collection\: labels, lock state, attributes' \
'ssh-list:List stored SSH key passphrases' \
'ssh-add:Store an SSH key passphrase, verified against the key first' \
'ssh-allow:Grant the askpass helper permission to answer for a stored key' \
'ssh-deny:Revoke the askpass helper'\''s permission to answer for a stored key' \
'ssh-remove:Remove a stored SSH key passphrase' \
'ssh-verify:Re-verify stored SSH key passphrases against their keys' \
'change:Change an existing collection'\''s password' \
'completions:Generate shell completions' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'gmellon commands' commands "$@"
}
